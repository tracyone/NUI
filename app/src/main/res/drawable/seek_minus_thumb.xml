<?xml version="1.0" encoding="utf-8"?>
<!-- 负一屏横条进度条滑块（绿色圆点，便于车机上瞄一眼就找到当前位置） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:width="16dp"
        android:height="16dp" />
    <solid android:color="#BF34C759" />
    <stroke
        android:width="1dp"
        android:color="#CC000000" />
</shape>
