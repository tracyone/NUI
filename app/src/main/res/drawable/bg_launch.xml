        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1A2330"
                android:centerColor="#0F1620"
                android:endColor="#070B11" />
        </shape>
    </item>
</layer-list>
