<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 悬浮地图区域 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapPanel"
        android:layout_width="600dp"
        android:layout_height="400dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <ImageButton
            android:id="@+id/btnSwitchMap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_dock_item"
            android:contentDescription="@string/dock_map"
            android:scaleType="centerInside"
            android:src="@drawable/ic_dock_map"
            android:tint="@color/text_primary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 右侧面板：导航按钮 / 时钟 / 音乐区（固定贴右缘，不随地图移动） -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_panel">

        <!-- 导航按钮：回家 / 公司 -->
        <LinearLayout
            android:id="@+id/navRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btnNavHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/navIconHome"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_nav_home_circle"
                    android:tint="#FFFFFF"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/navLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="回家"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavCompany"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/navIconCompany"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_nav_company_circle"
                    android:tint="#FFFFFF"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_company" />

                <TextView
                    android:id="@+id/navLabelCompany"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="公司"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavFavorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/navIconFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_nav_favorite_circle"
                    android:tint="#FFFFFF"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_favorite" />

                <TextView
                    android:id="@+id/navLabelFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="收藏"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 导航信息覆盖层：高德导航/巡航中替换"回家/公司/收藏"三按钮。
             设计：深蓝黑实色卡片 + 白色大字，任何壁纸下显眼；
                 导航模式：终点+全程 / 电子眼 / 出口 / 速度限速 / 服务区；
                 巡航模式：当前速度大字 / 最近测速 / 最近红绿灯（地图上不明显或没有的信息） -->
            <LinearLayout
                android:id="@+id/navInfoOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_nav_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <!-- ========== 导航模式内容 ========== -->
                <LinearLayout
                    android:id="@+id/navInfoNavBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <!-- 行1：转向图标 + 终点名 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/navInfoTurn"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:scaleType="centerInside"
                            android:contentDescription="转向" />

                        <TextView
                            android:id="@+id/navInfoDest"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="回家"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- 行2：全程剩余时间 · 距离 -->
                    <TextView
                        android:id="@+id/navInfoEta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="23分钟 · 12公里"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#E0F0FF"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- 行3：电子眼警示（黄色大字，仅测速/摄像时显示） -->
                    <TextView
                        android:id="@+id/navInfoCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nav_camera"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="⚠ 前方300米测速 限速60"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFD54F"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <!-- 行4：出口提示（仅高速显示） -->
                    <TextView
                        android:id="@+id/navInfoExit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="出口 郑州 · 2公里"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <!-- 行5：速度 · 限速 -->
                    <TextView
                        android:id="@+id/navInfoSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="65km/h · 限速80"
                        android:textSize="16sp"
                        android:textColor="#B0C4DE"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- 行6：服务区（仅高速公路显示；深绿指示牌风格，保留原样式） -->
                    <TextView
                        android:id="@+id/navInfoSapa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_sapa_board"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="原阳服务区 · 8公里"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <!-- 服务区小行：前方服务区个数 -->
                    <TextView
                        android:id="@+id/navInfoSapaMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="前方共 2 个服务区"
                        android:textSize="12sp"
                        android:textColor="#C8D8EA"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ========== 巡航模式内容 ========== -->
                <LinearLayout
                    android:id="@+id/navInfoCruiseBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <!-- 行1：当前速度大字（超速变红） -->
                    <TextView
                        android:id="@+id/cruiseSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="65km/h"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1" />

                    <!-- 行2：最近测速（黄色警示，仅测速时显示） -->
                    <TextView
                        android:id="@+id/cruiseCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_nav_camera"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="⚠ 前方300米 限速60"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFD54F"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <!-- 行3：最近红绿灯（方向+状态+倒计时；红灯红字/绿灯绿字） -->
                    <TextView
                        android:id="@+id/cruiseLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="🚦 直行 红灯 12秒"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FF6B6B"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        <!-- 时钟 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextClock
                android:id="@+id/clockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textSize="44sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/clockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="M月d日 EEE"
                android:format24Hour="M月d日 EEE"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/weatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 音乐区域 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/musicPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/map_bg"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/musicContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
