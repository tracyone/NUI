<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 悬浮地图区域 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapPanel"
        android:layout_width="600dp"
        android:layout_height="400dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <ImageButton
            android:id="@+id/btnSwitchMap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_dock_item"
            android:contentDescription="@string/dock_map"
            android:scaleType="centerInside"
            android:src="@drawable/ic_dock_map"
            android:tint="@color/text_primary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 右侧面板：导航按钮 / 时钟 / 音乐区（固定贴右缘，不随地图移动） -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_panel">

        <!-- 导航按钮：回家 / 公司 -->
        <LinearLayout
            android:id="@+id/navRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btnNavHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/navIconHome"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_nav_home_circle"
                    android:tint="#FFFFFF"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/navLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="回家"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavCompany"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/navIconCompany"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_nav_company_circle"
                    android:tint="#FFFFFF"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_company" />

                <TextView
                    android:id="@+id/navLabelCompany"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="公司"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavFavorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/navIconFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_nav_favorite_circle"
                    android:tint="#FFFFFF"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_favorite" />

                <TextView
                    android:id="@+id/navLabelFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="收藏"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 时钟 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextClock
                android:id="@+id/clockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textSize="44sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/clockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="M月d日 EEE"
                android:format24Hour="M月d日 EEE"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/weatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 音乐区域 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/musicPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/map_bg"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/musicContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
