<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/settings_bg"
    android:padding="24dp">

    <!-- 左侧：设置分类 -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                android:tint="@color/settings_label"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/titleSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/desktop_settings"
                android:textColor="@color/settings_label"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tabMusic"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_settings_tab"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/music"
            android:textColor="@color/settings_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tabSteering"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_settings_tab"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/steering_wheel"
            android:textColor="@color/settings_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tabAppearance"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_settings_tab"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/appearance"
            android:textColor="@color/settings_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tabVoice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_settings_tab"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/sound"
            android:textColor="@color/settings_label"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 右侧：详细设置 -->
    <LinearLayout
        android:id="@+id/contentCard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card"
        android:padding="24dp">

        <!-- 音乐详情 -->
        <LinearLayout
            android:id="@+id/panelMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/groupTitleMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music"
                android:textColor="@color/settings_group_title"
                android:textSize="14sp" />

            <View
                android:id="@+id/dividerMusic"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:background="@color/settings_divider" />

            <TextView
                android:id="@+id/tvLyricTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lyric_bg_alpha"
                android:textColor="@color/settings_label"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/seekLyricAlpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvLyricAlphaValue"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="20%"
                    android:textColor="@color/settings_value"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lyricHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lyric_bg_alpha_hint"
                android:textColor="@color/settings_value"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 方向盘详情 -->
        <LinearLayout
            android:id="@+id/panelSteering"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/groupTitleSteering"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/steering_wheel"
                android:textColor="@color/settings_group_title"
                android:textSize="14sp" />

            <View
                android:id="@+id/dividerSteering"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@+id/recordList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:id="@+id/dividerAdd"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/settings_divider" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_btn"
                android:text="@string/add_key_mapping"
                android:textColor="@color/settings_btn_text"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- 外观详情 -->
        <LinearLayout
            android:id="@+id/panelAppearance"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/groupTitleAppearance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance"
                        android:textColor="@color/settings_group_title"
                        android:textSize="14sp" />

                    <View
                        android:id="@+id/dividerAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/settings_divider" />

                    <!-- 跟随系统 -->
                    <LinearLayout
                        android:id="@+id/optSystem"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_settings_row_ripple"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvOptSystem"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/theme_system"
                            android:textColor="@color/settings_label"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/checkSystem"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="@color/settings_btn_text"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/settings_divider" />

                    <!-- 深色模式 -->
                    <LinearLayout
                        android:id="@+id/optDark"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_settings_row_ripple"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvOptDark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/theme_dark"
                            android:textColor="@color/settings_label"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/checkDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="@color/settings_btn_text"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/settings_divider" />

                    <!-- 浅色模式 -->
                    <LinearLayout
                        android:id="@+id/optLight"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_settings_row_ripple"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvOptLight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/theme_light"
                            android:textColor="@color/settings_label"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/checkLight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="@color/settings_btn_text"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Dock 形态分组 -->
                    <TextView
                        android:id="@+id/groupTitleDock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/dock_style"
                        android:textColor="@color/settings_group_title"
                        android:textSize="14sp" />

                    <View
                        android:id="@+id/dividerDock"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/settings_divider" />

                    <!-- 贴边（矩形） -->
                    <LinearLayout
                        android:id="@+id/optDockEdge"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_settings_row_ripple"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvOptDockEdge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dock_style_edge"
                            android:textColor="@color/settings_label"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/checkDockEdge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="@color/settings_btn_text"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/settings_divider" />

                    <!-- 悬浮（圆角） -->
                    <LinearLayout
                        android:id="@+id/optDockFloat"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_settings_row_ripple"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvOptDockFloat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dock_style_float"
                            android:textColor="@color/settings_label"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/checkDockFloat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="@color/settings_btn_text"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/settings_divider" />

                    <!-- Dock 图标大小 -->
                    <TextView
                        android:id="@+id/tvDockIconTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/dock_icon_scale"
                        android:textColor="@color/settings_label"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekDockIcon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:max="80" />

                        <TextView
                            android:id="@+id/tvDockIconValue"
                            android:layout_width="56dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="100%"
                            android:textColor="@color/settings_value"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/dock_icon_scale_hint"
                        android:textColor="@color/settings_value"
                        android:textSize="13sp" />

                    <!-- 应用列表图标大小 -->
                    <TextView
                        android:id="@+id/tvAppIconTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/app_icon_scale"
                        android:textColor="@color/settings_label"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekAppIcon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:max="80" />

                        <TextView
                            android:id="@+id/tvAppIconValue"
                            android:layout_width="56dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="100%"
                            android:textColor="@color/settings_value"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/app_icon_scale_hint"
                        android:textColor="@color/settings_value"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 声音详情 -->
        <LinearLayout
            android:id="@+id/panelVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/groupTitleVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_title"
                android:textColor="@color/settings_group_title"
                android:textSize="14sp" />

            <View
                android:id="@+id/dividerVoice"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:background="@color/settings_divider" />

            <!-- 女声（小雅） -->
            <LinearLayout
                android:id="@+id/optVoiceFemale"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_settings_row_ripple"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvOptVoiceFemale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voice_female"
                    android:textColor="@color/settings_label"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/checkVoiceFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/settings_btn_text"
                    android:textSize="20sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/settings_divider" />

            <!-- 男声（超文） -->
            <LinearLayout
                android:id="@+id/optVoiceMale"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_settings_row_ripple"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvOptVoiceMale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voice_male"
                    android:textColor="@color/settings_label"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/checkVoiceMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/settings_btn_text"
                    android:textSize="20sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
