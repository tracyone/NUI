<?xml version="1.0"?>
<!--
  导航/巡航信息卡（可复用布局）：page0 右侧面板与负一屏各 include 一份。
  设计：深蓝黑实色卡片 + 白色大字，任何壁纸下显眼；
    导航模式：终点+全程 / 电子眼 / 出口 / 速度限速 / 服务区；
    巡航模式：当前速度大字 / 最近测速 / 最近红绿灯（地图上不明显或没有的信息）。
  注意：根布局 id 由 <include> 标签覆盖（page0=navInfoOverlay，负一屏=navInfoOverlayMinus）；
  内部子 view id 两套相同，NavInfoHost 在各自容器内 findViewById，互不冲突。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_nav_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <!-- ========== 导航模式内容 ========== -->
    <LinearLayout
        android:id="@+id/navInfoNavBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <!-- 行1：转向图标 + 终点名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/navInfoTurn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerInside"
                android:contentDescription="转向"
                android:visibility="gone" />

            <TextView
                android:id="@+id/navInfoDest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="回家"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 行2：全程剩余时间 · 距离（重要信息，大字显示） -->
        <TextView
            android:id="@+id/navInfoEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="23分钟 · 12公里"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 行3：电子眼警示（黄色大字+摄像头图标，仅测速/摄像时显示） -->
        <LinearLayout
            android:id="@+id/navInfoCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_nav_camera"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/navInfoCameraIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/camera_shape"
                android:contentDescription="@null"
                android:src="@drawable/camera_default" />

            <TextView
                android:id="@+id/navInfoCameraText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="300米测速 限速60"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFD54F"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 行4：出口提示（仅高速显示） -->
        <TextView
            android:id="@+id/navInfoExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="出口 郑州 · 2公里"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 行5：前方拥堵（13011 TMC 实时路况；颜色按拥堵程度变化：
             黄=缓行 / 红=拥堵 / 深红=严重拥堵；当前拥堵时显示剩余距离） -->
        <TextView
            android:id="@+id/navInfoTmc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="前方800米 拥堵"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF5252"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- 行6：当前速度（黑底蓝圈）+ 标准限速红圈（与巡航卡样式对齐） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navSpeedCircle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_speed_circle"
                android:gravity="center"
                android:text="65"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <!-- 标准限速图标：红圈白底黑字（bg_speed_limit），超速时红字 -->
            <TextView
                android:id="@+id/navLimitCircle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_speed_limit"
                android:gravity="center"
                android:text="60"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 巡航模式内容 ========== -->
    <LinearLayout
        android:id="@+id/navInfoCruiseBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <!-- 行1：当前速度（黑底蓝圈）+ 标准限速红圈 同一行 -->
        <LinearLayout
            android:id="@+id/cruiseRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cruiseSpeed"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_speed_circle"
                android:gravity="center"
                android:text="65"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <!-- 标准限速图标：红圈白底黑字（bg_speed_limit），超速时红字 -->
            <TextView
                android:id="@+id/cruiseLimit"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_speed_limit"
                android:gravity="center"
                android:text="60"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 行2：摄像头（所有类型统一在此行，含限速摄像头）：类型图标 + 距离 -->
        <LinearLayout
            android:id="@+id/cruiseCamOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/cruiseCamOtherIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/camera_shape"
                android:contentDescription="@null"
                android:src="@drawable/camera_light" />

            <TextView
                android:id="@+id/cruiseCamOtherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="300米"
                android:textSize="40sp"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 行3：最近红绿灯（Navi-Link 样式：每个方向一个圆形灯+箭头+倒计时，代码动态生成） -->
        <LinearLayout
            android:id="@+id/cruiseLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
