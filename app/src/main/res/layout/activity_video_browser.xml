<?xml version="1.0" encoding="utf-8"?>
<!-- 视频文件浏览器（QuickTime「打开文件」风格）：
     顶部路径栏 + 存储设备切换条 + 文件列表。内置存储与 U盘/SD卡 等外接存储均可浏览。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E">

    <!-- 顶部路径栏：返回 + 当前路径 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnVideoBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/bg_minus_ctrl"
            android:contentDescription="返回"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/videoPathLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:singleLine="true"
            android:ellipsize="start"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="/storage/emulated/0/Movies" />
    </LinearLayout>

    <!-- 存储设备切换条（内置存储 / U盘 / SD卡 等，横向滚动） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/videoStorageBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <!-- 文件列表 -->
    <ListView
        android:id="@+id/videoFileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#22FFFFFF"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
