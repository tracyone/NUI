<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launch"
    android:fitsSystemWindows="false">

    <!-- ViewPager：左右翻页（Page0=地图桌面，Page1=应用网格） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 左侧 Dock 栏（固定不动，始终在最上层；贴边=矩形贯穿，悬浮=紧凑竖条居中） -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_dock">

        <TextClock
            android:id="@+id/dockClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:format24Hour="HH:mm"
            android:format12Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/dockItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal" />

        <ImageButton
            android:id="@+id/dockApps"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dock_item"
            android:contentDescription="@string/dock_apps"
            android:src="@drawable/ic_dock_n"
            android:scaleType="centerInside"
            android:tint="@color/dock_icon_tint" />
    </LinearLayout>

    <!-- 底部分页小圆点指示器 -->
    <LinearLayout
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal" />
</FrameLayout>
